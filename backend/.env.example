# Copy to backend/.env when you need to change the defaults.
# The default is a local SQLite database in backend/runtime/.
# DATABASE_URL=sqlite:///C:/your-project/backend/runtime/platform.sqlite3
# For your own MySQL database, URL-encode special characters in the password:
# DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/YOUR_DATABASE
# ROBUSTNESS_STORAGE_DIR=C:/your-project/backend/runtime
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
